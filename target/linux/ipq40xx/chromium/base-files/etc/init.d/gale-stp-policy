#!/bin/sh /etc/rc.common

START=21
STOP=89
USE_PROCD=1

start_service()
{
	. /lib/functions.sh
	. /lib/functions/system.sh

	[ "$(board_name)" = "google,wifi" ] || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/gale-stp-policy daemon
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

reload_service()
{
	/usr/libexec/gale-stp-policy apply
}

service_triggers()
{
	procd_add_reload_trigger network wireless
}
